# Discord bot token from the Discord Developer Portal > Bot
DISCORD_TOKEN=your-discord-bot-token

# Discord application ID
DISCORD_CLIENT_ID=123456789012345678

# Optional for the bot process. Required by `npm run deploy-commands` when deploying
# guild-scoped commands outside production.
DISCORD_GUILD_ID=

# JSON array of Lavalink nodes. The bot enables node failover automatically when more
# than one node is configured. For local docker-compose usage, the compose file overrides
# this value to point at the `lavalink` service.
LAVALINK_NODES=[{"name":"main","url":"localhost:2333","auth":"youshallnotpass","secure":false,"reconnectTries":15,"reconnectInterval":5000}]

# Initial playback volume from 0 to 200.
DEFAULT_VOLUME=100

# Disconnect after this many milliseconds of idle voice time unless 24/7 mode is enabled.
INACTIVITY_TIMEOUT_MS=300000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated Discord user IDs that bypass DJ mode restrictions.
BOT_OWNER_IDS=123456789012345678